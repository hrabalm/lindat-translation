assumeWellformed: false
preserve_whitespace: false
attributes:
  dir:
    ruleTypes: [ATTRIBUTE_WRITABLE]
    allElementsExcept: [base, basefront, head, html, meta, param, script]
  title:
    ruleTypes: [ATTRIBUTE_TRANS]
  lang:
    ruleTypes: [ATTRIBUTE_WRITABLE]
  xml:lang:
    ruleTypes: [ATTRIBUTE_WRITABLE]
  aria-label:
    ruleTypes: [ATTRIBUTE_TRANS]
elements:
  # Keep formulas inline and shield symbolic leaves, not mtext prose.
  # Local preservation cannot undo whitespace collapsed by XML extraction.
  math:
    ruleTypes: [INLINE, PRESERVE_WHITESPACE]
  mrow:
    ruleTypes: [INLINE]
  msub:
    ruleTypes: [INLINE]
  msup:
    ruleTypes: [INLINE]
  msubsup:
    ruleTypes: [INLINE]
  mfrac:
    ruleTypes: [INLINE]
  msqrt:
    ruleTypes: [INLINE]
  mroot:
    ruleTypes: [INLINE]
  munder:
    ruleTypes: [INLINE]
  mover:
    ruleTypes: [INLINE]
  munderover:
    ruleTypes: [INLINE]
  mfenced:
    ruleTypes: [INLINE]
  mtable:
    ruleTypes: [INLINE]
  mtr:
    ruleTypes: [INLINE]
  mtd:
    ruleTypes: [INLINE]
  semantics:
    ruleTypes: [INLINE]
  mi:
    ruleTypes: [INLINE, EXCLUDE]
  mn:
    ruleTypes: [INLINE, EXCLUDE]
  mo:
    ruleTypes: [INLINE, EXCLUDE]
  mtext:
    ruleTypes: [INLINE]
  annotation:
    ruleTypes: [INLINE, EXCLUDE]
  annotation-xml:
    ruleTypes: [INLINE, EXCLUDE]
  m:math:
    ruleTypes: [INLINE, PRESERVE_WHITESPACE]
  m:mrow:
    ruleTypes: [INLINE]
  m:msub:
    ruleTypes: [INLINE]
  m:msup:
    ruleTypes: [INLINE]
  m:msubsup:
    ruleTypes: [INLINE]
  m:mfrac:
    ruleTypes: [INLINE]
  m:msqrt:
    ruleTypes: [INLINE]
  m:mroot:
    ruleTypes: [INLINE]
  m:munder:
    ruleTypes: [INLINE]
  m:mover:
    ruleTypes: [INLINE]
  m:munderover:
    ruleTypes: [INLINE]
  m:mfenced:
    ruleTypes: [INLINE]
  m:mtable:
    ruleTypes: [INLINE]
  m:mtr:
    ruleTypes: [INLINE]
  m:mtd:
    ruleTypes: [INLINE]
  m:semantics:
    ruleTypes: [INLINE]
  m:mi:
    ruleTypes: [INLINE, EXCLUDE]
  m:mn:
    ruleTypes: [INLINE, EXCLUDE]
  m:mo:
    ruleTypes: [INLINE, EXCLUDE]
  m:mtext:
    ruleTypes: [INLINE]
  m:annotation:
    ruleTypes: [INLINE, EXCLUDE]
  m:annotation-xml:
    ruleTypes: [INLINE, EXCLUDE]
  mml:math:
    ruleTypes: [INLINE, PRESERVE_WHITESPACE]
  mml:mrow:
    ruleTypes: [INLINE]
  mml:msub:
    ruleTypes: [INLINE]
  mml:msup:
    ruleTypes: [INLINE]
  mml:msubsup:
    ruleTypes: [INLINE]
  mml:mfrac:
    ruleTypes: [INLINE]
  mml:msqrt:
    ruleTypes: [INLINE]
  mml:mroot:
    ruleTypes: [INLINE]
  mml:munder:
    ruleTypes: [INLINE]
  mml:mover:
    ruleTypes: [INLINE]
  mml:munderover:
    ruleTypes: [INLINE]
  mml:mfenced:
    ruleTypes: [INLINE]
  mml:mtable:
    ruleTypes: [INLINE]
  mml:mtr:
    ruleTypes: [INLINE]
  mml:mtd:
    ruleTypes: [INLINE]
  mml:semantics:
    ruleTypes: [INLINE]
  mml:mi:
    ruleTypes: [INLINE, EXCLUDE]
  mml:mn:
    ruleTypes: [INLINE, EXCLUDE]
  mml:mo:
    ruleTypes: [INLINE, EXCLUDE]
  mml:mtext:
    ruleTypes: [INLINE]
  mml:annotation:
    ruleTypes: [INLINE, EXCLUDE]
  mml:annotation-xml:
    ruleTypes: [INLINE, EXCLUDE]
  g:
    ruleTypes: [INLINE]
  meta:
    ruleTypes: [ATTRIBUTES_ONLY]
    translatableAttributes:
      content:
      - [http-equiv, EQUALS, keywords]
      - - name
        - EQUALS
        - [keywords, description, 'twitter:title', 'twitter:description', 'og:title',
          'og:description', 'og:site_name']
    writableLocalizableAttributes:
      content:
      - http-equiv
      - EQUALS
      - [content-language, content-type]
      charset: null
    readOnlyLocalizableAttributes:
      content:
      - name
      - EQUALS
      - [generator, author, progid, date]
  area:
    ruleTypes: [ATTRIBUTES_ONLY]
    translatableAttributes: [accesskey, area, alt, download]
  isindex:
    ruleTypes: [ATTRIBUTES_ONLY]
    translatableAttributes: [prompt]
  option:
    ruleTypes: [ATTRIBUTES_ONLY]
    translatableAttributes: [label]
  optgroup:
    ruleTypes: [ATTRIBUTES_ONLY]
    translatableAttributes: [label]
  address:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  dt:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  dd:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  h1:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  h2:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  h3:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  h4:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  h5:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  h6:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  legend:
    ruleTypes: [TEXTUNIT]
    translatableAttributes: [accesskey]
    idAttributes: [id]
  li:
    ruleTypes: [TEXTUNIT]
    translatableAttributes: [value]
    idAttributes: [id]
  marquee:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  p:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
    elementType: paragraph
  pre:
    ruleTypes: [TEXTUNIT, PRESERVE_WHITESPACE]
    idAttributes: [id]
  td:
    ruleTypes: [TEXTUNIT]
    translatableAttributes: [abbr]
    idAttributes: [id]
  th:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
    translatableAttributes: [abbr]
  title:
    ruleTypes: [TEXTUNIT]
    idAttributes: [id]
  track:
    translatableAttributes: [label, srclang]
    writableLocalizableAttributes: [src]
  a:
    ruleTypes: [INLINE]
    elementType: link
    translatableAttributes: [title, accesskey, download]
    writableLocalizableAttributes: [href]
  audio:
    writableLocalizableAttributes: [src]
  abbr:
    ruleTypes: [INLINE]
  acronym:
    ruleTypes: [INLINE]
  applet:
    ruleTypes: [INLINE]
    translatableAttributes: [alt]
  b:
    ruleTypes: [INLINE]
    elementType: bold
  base:
    ruleTypes: [ATTRIBUTES_ONLY]
    writableLocalizableAttributes: [href]
  bdo:
    ruleTypes: [INLINE]
  big:
    ruleTypes: [INLINE]
  blink:
    ruleTypes: [INLINE]
  br:
    ruleTypes: [INLINE]
  button:
    ruleTypes: [INLINE]
    translatableAttributes: [accesskey, value]
  cite:
    ruleTypes: [INLINE]
  code:
    ruleTypes: [INLINE]
  del:
    ruleTypes: [INLINE]
  dfn:
    ruleTypes: [INLINE]
  em:
    ruleTypes: [INLINE]
  embed:
    ruleTypes: [INLINE]
  font:
    ruleTypes: [INLINE]
  i:
    ruleTypes: [INLINE]
    elementType: italic
  iframe:
    ruleTypes: [INLINE]
    translatableAttributes: [srcdoc]
  img:
    ruleTypes: [INLINE]
    elementType: image
    translatableAttributes: [title, alt]
    writableLocalizableAttributes: [href, src]
  input:
    ruleTypes: [INLINE]
    translatableAttributes:
      alt:
      - type
      - NOT_EQUALS
      - [file, hidden, image, Password]
      value:
      - type
      - NOT_EQUALS
      - [file, hidden, image, Password]
      accesskey:
      - type
      - NOT_EQUALS
      - [file, hidden, image, Password]
      title:
      - type
      - NOT_EQUALS
      - [file, hidden, image, Password]
      placeholder: [type, NOT_EQUALS, dummy]
  ins:
    ruleTypes: [INLINE]
  kbd:
    ruleTypes: [INLINE]
  label:
    ruleTypes: [INLINE]
    translatableAttributes: [accesskey]
  map:
    ruleTypes: [INLINE]
  menuitem:
    translatableAttributes: [label]
  nobr:
    ruleTypes: [INLINE]
  object:
    ruleTypes: [INLINE]
    translatableAttributes: [standby]
  param:
    ruleTypes: [INLINE]
    translatableAttributes: [value]
  q:
    ruleTypes: [INLINE]
  s:
    ruleTypes: [INLINE]
  samp:
    ruleTypes: [INLINE]
  small:
    ruleTypes: [INLINE]
  select:
    ruleTypes: [INLINE]
  span:
    ruleTypes: [INLINE]
  spacer:
    ruleTypes: [INLINE]
  strike:
    ruleTypes: [INLINE]
  strong:
    ruleTypes: [INLINE]
  sub:
    ruleTypes: [INLINE]
  sup:
    ruleTypes: [INLINE]
  table:
    ruleTypes: [ATTRIBUTES_ONLY]
    translatableAttributes: [summary]
  textarea:
    ruleTypes: [INLINE]
    translatableAttributes: [accesskey, placeholder]
  tt:
    ruleTypes: [INLINE]
  u:
    ruleTypes: [INLINE]
    elementType: underlined
  var:
    ruleTypes: [INLINE]
  wbr:
    ruleTypes: [INLINE]
  ruby:
    ruleTypes: [INLINE]
  rb:
    ruleTypes: [INLINE]
  rt:
    ruleTypes: [INLINE]
  rc:
    ruleTypes: [INLINE]
  rp:
    ruleTypes: [INLINE]
  rbc:
    ruleTypes: [INLINE]
  rtc:
    ruleTypes: [INLINE]
  symbol:
    ruleTypes: [INLINE]
  face:
    ruleTypes: [INLINE]
  .*:
    ruleTypes: [EXCLUDE]
    conditions: [translate, EQUALS, no]
  .+:
    ruleTypes: [INCLUDE]
    conditions: [translate, EQUALS, yes]
  style:
    ruleTypes: [EXCLUDE]
  stylesheet:
    ruleTypes: [EXCLUDE]
  script:
    ruleTypes: [EXCLUDE]
